# KRONOS CI — local configuration.
# Copy this file to ".kronos-ci.env" in your project root. The local git hook (install.sh) sources it.
# These are the SAME settings the GitHub Action uses, just as shell variables.

# The core check — KRONOS CI runs this itself and requires it to pass:
export INPUT_TEST_COMMAND="pytest -q"

# --- everything below is optional ---

# export INPUT_LINT_COMMAND="ruff check ."
# export INPUT_LINT_REQUIRED="true"            # else advisory

# Catch a runner that exits 0 but printed failures:
# export INPUT_SCAN_TEST_OUTPUT="true"

# Require a plan file / docs-with-code:
# export INPUT_REQUIRE_PLAN="true"
# export INPUT_REQUIRE_DOCS="true"

# Scan added diff lines (merge-conflict markers are always caught):
# export INPUT_FORBIDDEN_PATTERNS="pdb.set_trace,console\\.log"

# Enforce a commit-message convention:
# export INPUT_COMMIT_PATTERN="^(feat|fix|docs|chore|refactor|test|ci): .+"

# Enforce a minimum test coverage (the percentage is parsed from the command's output):
# export INPUT_COVERAGE_COMMAND="pytest --cov=src -q"
# export INPUT_COVERAGE_MIN="80"

# Added diff lines are scanned for credential shapes BY DEFAULT (AWS keys, tokens, private keys,
# hardcoded passwords). Disable only if you must:
# export INPUT_SECRETS_SCAN="false"

# Keep PRs reviewable (advisory unless required):
# export INPUT_SIZE_MAX_LINES="1500"
# export INPUT_SIZE_REQUIRED="false"

# Kill a hung test/lint/coverage command after N seconds (default 1800):
# export INPUT_COMMAND_TIMEOUT="1800"

# One rigor knob, and the full-discipline mode:
# export INPUT_PROFILE="standard"              # minimal | standard | strict
# export INPUT_TYPE="medium"                   # trivial | micro | medium | large | ops
# export INPUT_WORKFLOW_FILE="WORKFLOW.md"     # verify a committed 5-stage process record

# A commit whose message contains "[kronos skip]" bypasses the gate (recorded loudly).
